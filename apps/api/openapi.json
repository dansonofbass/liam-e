    "/api/v1/mail/messages": {
      "get": {
        "description": "Search the synced mail index across all connected accounts.\n\n``q`` matches case-insensitively as a substring of subject, sender and body, ``account_id``\nrestricts the search to one account and ``limit`` caps the result count (1-200). Messages are\nreturned with the newest ``internal_date`` first.",
        "operationId": "mail_messages_search",
        "parameters": [
          {
            "description": "Volltext \u00fcber Betreff, Absender und Inhalt",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "description": "Volltext \u00fcber Betreff, Absender und Inhalt",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "account_id",
            "required": false,
            "schema": {
              "default": "",
              "title": "Account Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MessageOut"
                  },
                  "title": "Response Mail Messages Search",
