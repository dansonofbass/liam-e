    "/api/v1/mail/connectors/{name}/connect": {
      "post": {
        "description": "Register a Studio connector such as ``gmail`` as a mail account and return it.\n\nThe connector keeps the OAuth credentials inside Mistral, so the app stores no secret; the\naccount's e-mail address is derived from a one-message ``search_threads`` call when the\nconnector offers that tool and otherwise stays a placeholder. Answers 201.",
        "operationId": "mail_account_connect_connector",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
