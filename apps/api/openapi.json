{
  "components": {
    "schemas": {
      "AccountOut": {
        "properties": {
          "auth_type": {
            "title": "Auth Type",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email_address": {
            "title": "Email Address",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "auth_type",
          "email_address",
          "display_name",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "ChatMessageOut": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "draft_json": {
            "title": "Draft Json",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "tool_name": {
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "role",
          "content",
          "tool_name",
          "draft_json",
          "created_at"
        ],
        "title": "ChatMessageOut",
        "type": "object"
      },
      "ChatTurnRequest": {
        "properties": {
          "conversation_id": {
            "default": "",
            "description": "Leer lassen f\u00fcr eine neue Konversation",
            "title": "Conversation Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatTurnRequest",
        "type": "object"
      },
      "ChatTurnResponse": {
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageOut"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "conversation_id",
          "messages"
        ],
        "title": "ChatTurnResponse",
        "type": "object"
      },
      "ConnectorOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "id"
        ],
        "title": "ConnectorOut",
        "type": "object"
      },
      "ConnectorToolOut": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "input_schema"
        ],
        "title": "ConnectorToolOut",
        "type": "object"
      },
      "ConversationOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationOut",
        "type": "object"
      },
      "DependencyStatus": {
        "properties": {
          "configured": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Configured"
          },
          "reachable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reachable"
          }
        },
        "title": "DependencyStatus",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "deployment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployment"
          },
          "deps": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Deps",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "deps"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ImapConnectRequest": {
        "properties": {
          "email_address": {
            "title": "Email Address",
            "type": "string"
          },
          "imap_host": {
            "default": "",
            "title": "Imap Host",
            "type": "string"
          },
          "imap_port": {
            "default": 993,
            "title": "Imap Port",
            "type": "integer"
          },
          "password": {
            "default": "",
            "description": "IMAP app password (e.g. iCloud/Yahoo app-specific password). Exactly one of password / password_secret.",
            "title": "Password",
            "type": "string"
          },
          "password_secret": {
            "default": "",
            "description": "Name of a Mistral workspace secret holding the app password (lowercase, e.g. 'yahoo-app-password') \u2014 one secret per account. Only the reference is stored.",
            "title": "Password Secret",
            "type": "string"
          },
          "smtp_host": {
            "default": "",
            "title": "Smtp Host",
            "type": "string"
          },
          "smtp_port": {
            "default": 465,
            "title": "Smtp Port",
            "type": "integer"
          },
          "smtp_starttls": {
            "default": false,
            "title": "Smtp Starttls",
            "type": "boolean"
          }
        },
        "required": [
          "email_address"
        ],
        "title": "ImapConnectRequest",
        "type": "object"
      },
      "MessageOut": {
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "body_text": {
            "title": "Body Text",
            "type": "string"
          },
          "folder": {
            "title": "Folder",
            "type": "string"
          },
          "has_attachments": {
            "title": "Has Attachments",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "internal_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Internal Date"
          },
          "is_read": {
            "title": "Is Read",
            "type": "boolean"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "title": "Labels",
            "type": "array"
          },
          "provider_uid": {
            "title": "Provider Uid",
            "type": "string"
          },
          "recipients": {
            "items": {
              "type": "string"
            },
            "title": "Recipients",
            "type": "array"
          },
          "sender": {
            "title": "Sender",
            "type": "string"
          },
          "snippet": {
            "title": "Snippet",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "account_id",
          "folder",
          "provider_uid",
          "thread_id",
          "subject",
          "sender",
          "recipients",
          "snippet",
          "body_text",
          "internal_date",
          "has_attachments",
          "is_read",
          "labels"
        ],
        "title": "MessageOut",
        "type": "object"
      },
      "OAuthAuthorizeOut": {
        "properties": {
          "authorization_url": {
            "title": "Authorization Url",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "authorization_url",
          "state"
        ],
        "title": "OAuthAuthorizeOut",
        "type": "object"
      },
      "SyncOut": {
        "properties": {
          "cursor": {
            "title": "Cursor",
            "type": "string"
          },
          "last_error": {
            "default": "",
            "title": "Last Error",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "synced": {
            "title": "Synced",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "synced",
          "cursor"
        ],
        "title": "SyncOut",
        "type": "object"
      },
      "ToolCallRequest": {
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "default": {},
            "title": "Arguments",
            "type": "object"
          }
        },
        "title": "ToolCallRequest",
        "type": "object"
      },
      "ToolCallResult": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "ToolCallResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "The app's status and each dependency's: whether Mistral is configured, whether each checked\nservice answers. ``degraded`` when one does not; the response is 200 either way.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Report dependency status; always answers 200"
      }
    },
    "/api/v1/chat": {
      "post": {
        "operationId": "chat_turn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatTurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatTurnResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send a message to the mail agent"
      }
    },
    "/api/v1/chat/conversations": {
      "get": {
        "operationId": "chat_conversations_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConversationOut"
                  },
                  "title": "Response Chat Conversations List",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List all chat conversations, newest first"
      }
    },
    "/api/v1/chat/drafts/{draft_id}": {
      "delete": {
        "operationId": "chat_draft_cancel",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
            "schema": {
              "title": "Draft Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatMessageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel a pending draft"
      }
    },
    "/api/v1/chat/drafts/{draft_id}/confirm": {
      "post": {
        "operationId": "chat_draft_confirm",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
            "schema": {
              "title": "Draft Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatMessageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send the confirmed draft for real"
      }
    },
    "/api/v1/chat/history": {
      "get": {
        "operationId": "chat_history",
        "parameters": [
          {
            "in": "query",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChatMessageOut"
                  },
                  "title": "Response Chat History",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "All messages of one conversation, in order"
      }
    },
    "/api/v1/mail/accounts": {
      "get": {
        "operationId": "mail_accounts_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountOut"
                  },
                  "title": "Response Mail Accounts List",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List all connected mail accounts"
      }
    },
    "/api/v1/mail/accounts/imap": {
      "post": {
        "operationId": "mail_account_connect_imap",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImapConnectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Connect an IMAP/SMTP account"
      }
    },
    "/api/v1/mail/accounts/oauth/{provider}/authorize": {
      "get": {
        "operationId": "mail_account_oauth_authorize",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "enum": [
                "google",
                "microsoft"
              ],
              "title": "Provider",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthAuthorizeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start the OAuth2 flow for google or microsoft; open the returned URL in the browser"
      }
    },
    "/api/v1/mail/accounts/oauth/{provider}/callback": {
      "get": {
        "operationId": "mail_account_oauth_callback",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "enum": [
                "google",
                "microsoft"
              ],
              "title": "Provider",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "title": "State",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "OAuth2 redirect target: exchanges the code and stores the encrypted tokens"
      }
    },
    "/api/v1/mail/accounts/{account_id}": {
      "delete": {
        "operationId": "mail_account_delete",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete an account and all its data"
      }
    },
    "/api/v1/mail/accounts/{account_id}/sync": {
      "post": {
        "operationId": "mail_account_sync",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sync the account into the local mail index"
      }
    },
    "/api/v1/mail/connectors": {
      "get": {
        "operationId": "mail_connectors_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConnectorOut"
                  },
                  "title": "Response Mail Connectors List",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List the workspace's Mistral Studio connectors"
      }
    },
    "/api/v1/mail/connectors/{name}/connect": {
      "post": {
        "operationId": "mail_account_connect_connector",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Connect a Studio connector (e.g. gmail) as a mail account"
      }
    },
    "/api/v1/mail/connectors/{name}/tools": {
      "get": {
        "operationId": "mail_connector_tools_list",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConnectorToolOut"
                  },
                  "title": "Response Mail Connector Tools List",
                  "type": "array"
                }
