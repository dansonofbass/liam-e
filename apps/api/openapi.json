{
  "components": {
    "schemas": {
      "AccountOut": {
        "properties": {
          "auth_type": {
            "title": "Auth Type",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email_address": {
            "title": "Email Address",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "auth_type",
          "email_address",
          "display_name",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "ChatMessageOut": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "draft_json": {
            "title": "Draft Json",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "tool_name": {
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "role",
          "content",
          "tool_name",
          "draft_json",
          "created_at"
        ],
        "title": "ChatMessageOut",
        "type": "object"
      },
      "ChatTurnRequest": {
        "properties": {
          "conversation_id": {
            "default": "",
            "description": "Leer lassen f\u00fcr eine neue Konversation",
            "title": "Conversation Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatTurnRequest",
        "type": "object"
      },
      "ChatTurnResponse": {
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageOut"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "conversation_id",
          "messages"
        ],
        "title": "ChatTurnResponse",
        "type": "object"
      },
      "ConnectorOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "id"
        ],
        "title": "ConnectorOut",
        "type": "object"
      },
      "ConnectorToolOut": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "input_schema"
        ],
        "title": "ConnectorToolOut",
        "type": "object"
      },
      "ConversationOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationOut",
        "type": "object"
      },
      "DependencyStatus": {
        "properties": {
          "configured": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Configured"
          },
          "reachable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reachable"
          }
        },
        "title": "DependencyStatus",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "deployment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployment"
          },
          "deps": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Deps",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "deps"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ImapConnectRequest": {
        "properties": {
          "email_address": {
            "title": "Email Address",
            "type": "string"
          },
          "imap_host": {
            "default": "",
            "title": "Imap Host",
            "type": "string"
          },
          "imap_port": {
            "default": 993,
            "title": "Imap Port",
            "type": "integer"
          },
          "password": {
            "default": "",
            "description": "IMAP app password (e.g. iCloud/Yahoo app-specific password). Exactly one of password / password_secret.",
            "title": "Password",
            "type": "string"
          },
          "password_secret": {
            "default": "",
            "description": "Name of a Mistral workspace secret holding the app password (lowercase, e.g. 'yahoo-app-password') \u2014 one secret per account. Only the reference is stored.",
            "title": "Password Secret",
            "type": "string"
          },
          "smtp_host": {
            "default": "",
            "title": "Smtp Host",
            "type": "string"
          },
          "smtp_port": {
            "default": 465,
            "title": "Smtp Port",
            "type": "integer"
          },
          "smtp_starttls": {
            "default": false,
            "title": "Smtp Starttls",
            "type": "boolean"
          }
        },
        "required": [
          "email_address"
        ],
        "title": "ImapConnectRequest",
        "type": "object"
      },
      "MessageOut": {
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "body_text": {
            "title": "Body Text",
            "type": "string"
          },
          "folder": {
            "title": "Folder",
            "type": "string"
          },
          "has_attachments": {
            "title": "Has Attachments",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "internal_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Internal Date"
          },
          "is_read": {
            "title": "Is Read",
            "type": "boolean"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "title": "Labels",
            "type": "array"
          },
          "provider_uid": {
            "title": "Provider Uid",
            "type": "string"
          },
          "recipients": {
            "items": {
              "type": "string"
            },
            "title": "Recipients",
            "type": "array"
          },
          "sender": {
            "title": "Sender",
            "type": "string"
          },
          "snippet": {
            "title": "Snippet",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "account_id",
          "folder",
          "provider_uid",
          "thread_id",
          "subject",
          "sender",
          "recipients",
          "snippet",
          "body_text",
          "internal_date",
          "has_attachments",
          "is_read",
          "labels"
        ],
        "title": "MessageOut",
        "type": "object"
      },
      "OAuthAuthorizeOut": {
        "properties": {
          "authorization_url": {
            "title": "Authorization Url",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "authorization_url",
          "state"
        ],
        "title": "OAuthAuthorizeOut",
        "type": "object"
      },
      "SyncOut": {
        "properties": {
          "cursor": {
            "title": "Cursor",
            "type": "string"
          },
          "error_code": {
            "default": "",
            "title": "Error Code",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "synced": {
            "title": "Synced",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "synced",
          "cursor"
        ],
        "title": "SyncOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "The app's status and each dependency's: whether Mistral is configured, whether each checked\nservice answers. ``degraded`` when one does not; the response is 200 either way.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Report dependency status; always answers 200"
      }
    },
    "/api/v1/chat": {
      "post": {
        "description": "Send one chat message to the mail agent and return the messages it produced.\n\nPass an empty ``conversation_id`` to start a new conversation; the response returns the\nconversation id to continue with. The agent may create a pending draft, but this operation\nnever sends a mail by itself.",
        "operationId": "chat_turn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatTurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatTurnResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send a message to the mail agent"
      }
    },
    "/api/v1/chat/conversations": {
      "get": {
        "description": "List all chat conversations, most recently updated first.",
        "operationId": "chat_conversations_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConversationOut"
                  },
                  "title": "Response Chat Conversations List",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List all chat conversations, newest first"
      }
    },
    "/api/v1/chat/drafts/{draft_id}": {
      "delete": {
        "description": "Discard a pending draft without sending it \u2014 no mail is delivered.\n\n``draft_id`` identifies the draft chat message; it answers 404 when the id is not a draft\nand 409 when the draft was already handled (sent, failed or cancelled). The returned message\ncarries the draft with status ``cancelled``.",
        "operationId": "chat_draft_cancel",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
            "schema": {
              "title": "Draft Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatMessageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel a pending draft"
      }
    },
    "/api/v1/chat/drafts/{draft_id}/confirm": {
      "post": {
        "description": "Send the pending draft for real; this is the only path that actually sends a mail.\n\n``draft_id`` identifies the pending draft chat message, which is sent to its recipients via\nthe account that created it. On success the draft is stored with status ``sent`` and the\nprovider's send result; a send failure stores status ``failed`` with a safe error code.\nBlocked hosts answer 422 and other send failures 502. Unknown or already handled\ndrafts answer 404 and 409.",
        "operationId": "chat_draft_confirm",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
            "schema": {
              "title": "Draft Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatMessageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send the confirmed draft for real"
      }
    },
    "/api/v1/chat/history": {
      "get": {
        "description": "Return every message of one conversation in conversation order.\n\n``conversation_id`` selects the conversation; an unknown id answers 404.",
        "operationId": "chat_history",
        "parameters": [
          {
            "in": "query",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChatMessageOut"
                  },
                  "title": "Response Chat History",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "All messages of one conversation, in order"
      }
    },
    "/api/v1/mail/accounts": {
      "get": {
        "description": "List all connected mail accounts with provider, auth type and e-mail address.\n\nCredentials are never part of the response.",
        "operationId": "mail_accounts_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountOut"
                  },
                  "title": "Response Mail Accounts List",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List all connected mail accounts"
      }
    },
    "/api/v1/mail/accounts/imap": {
      "post": {
        "description": "Connect an IMAP/SMTP account with an app password and store its credentials encrypted.\n\nExactly one of ``password`` or ``password_secret`` is required; ``password_secret`` names a\nworkspace secret (for example ``yahoo-app-password``) whose value is resolved now and re-read\nat runtime, so only the reference is stored. Server hosts must be allow-listed and the IMAP\nlogin is checked before the account is created; answers 201 with the new account.\nAn address already using another connection type answers 409 without changing credentials.",
        "operationId": "mail_account_connect_imap",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImapConnectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Connect an IMAP/SMTP account"
      }
    },
    "/api/v1/mail/accounts/oauth/{provider}/authorize": {
      "get": {
        "description": "Start the OAuth2 flow for ``google`` or ``microsoft`` and return the URL to open in a browser.\n\nThe response carries the ``authorization_url`` plus the signed ``state`` that the provider\nechoes back to the callback; nothing is redirected here. Answers 503 when that provider's\nOAuth client is not configured.",
        "operationId": "mail_account_oauth_authorize",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "enum": [
                "google",
                "microsoft"
              ],
              "title": "Provider",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthAuthorizeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start the OAuth2 flow for google or microsoft; open the returned URL in the browser"
      }
    },
    "/api/v1/mail/accounts/oauth/{provider}/callback": {
      "get": {
        "description": "OAuth2 redirect target: exchange the authorization code and store the encrypted tokens.\n\nThe signed ``state`` must match ``provider``; the provider's e-mail address decides which\nmail account is created or updated (auth type ``oauth2``) and returned.\nAn address already using another connection type answers 409 without changing credentials.",
        "operationId": "mail_account_oauth_callback",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "enum": [
                "google",
                "microsoft"
              ],
              "title": "Provider",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "title": "State",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "OAuth2 redirect target: exchanges the code and stores the encrypted tokens"
      }
    },
    "/api/v1/mail/accounts/{account_id}": {
      "delete": {
        "description": "Delete a mail account together with its credentials, synced messages and sync state.\n\n``account_id`` selects the account; the data cannot be restored. Answers 204 on success and\n404 for an unknown account.",
        "operationId": "mail_account_delete",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete an account and all its data"
      }
    },
    "/api/v1/mail/accounts/{account_id}/sync": {
      "post": {
        "description": "Sync one connected account's mail into the local index and return the result.\n\n``account_id`` selects the account; the response reports the ``status``, the number of\nmessages ``synced`` and the new ``cursor``. Provider failures do not raise \u2014 they return\nstatus ``error`` with ``error_code``.",
        "operationId": "mail_account_sync",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sync the account into the local mail index"
      }
    },
    "/api/v1/mail/connectors": {
      "get": {
        "description": "List the Mistral Studio connectors of this workspace as ``name``/``id`` pairs.\n\nThese are the connectors that can be registered as a mail account.",
        "operationId": "mail_connectors_list",
        "responses": {
          "200": {
