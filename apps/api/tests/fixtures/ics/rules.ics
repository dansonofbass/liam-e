BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Example//Synthetic calendar//EN
BEGIN:VEVENT
UID:monthly@example.org
DTSTART;VALUE=DATE:20260130
DURATION:P1D
RRULE:FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1;COUNT=4
SUMMARY:Last weekday
END:VEVENT
BEGIN:VEVENT
UID:gap@example.org
DTSTART;TZID=Europe/Berlin:20260328T023000
DURATION:PT30M
RRULE:FREQ=DAILY;COUNT=3
SUMMARY:Skip nonexistent local candidate before counting
END:VEVENT
BEGIN:VEVENT
UID:until@example.org
DTSTART:20260328T080000Z
DURATION:PT1H
RRULE:FREQ=DAILY;UNTIL=20260330T080000Z
SUMMARY:Inclusive UNTIL
END:VEVENT
END:VCALENDAR
